{
    "name":  "wledashboard",
    "version":  "0.15.1",
    "private":  true,
    "description":  "Premium local-first WLED device control surface",
    "workspaces":  [
                       "apps/api",
                       "apps/web"
                   ],
    "scripts":  {
                    "dev":  "npm run dev --workspace=apps/api \u0026 npm run dev --workspace=apps/web",
                    "dev:api":  "npm run dev --workspace=apps/api",
                    "dev:web":  "npm run dev --workspace=apps/web",
                    "build":  "npm run build --workspace=apps/web \u0026\u0026 npm run build --workspace=apps/api",
                    "lint":  "npm run lint --workspaces",
                    "test":  "npm run test --workspaces"
                },
    "engines":  {
                    "node":  "\u003e=22.0.0",
                    "npm":  "\u003e=10.0.0"
                }
}
